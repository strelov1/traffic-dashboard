node_modules/
dist/
coverage/

# Local agent tooling. The OpenSpec artifacts under openspec/ are tracked;
# the generated commands and skills under .claude/ are not.
.claude/

# Local configuration; .env.example is the tracked template.
.env
.env.local

*.log
.DS_Store

# Terraform. State holds every generated secret in plaintext — random_password
# among them — and tfvars holds the API token. Neither belongs in a repository,
# least of all a public one.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl
crash.log
