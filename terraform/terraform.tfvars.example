# Copy to terraform.tfvars, which is gitignored. The token also lives in the
# repository's Actions secrets, where the deploy workflow reads it from.
hcloud_token   = "..."
public_domain  = "traffic.example.com"
ssh_public_key    = "ssh-ed25519 AAAA... you@laptop"
deploy_public_key = "ssh-ed25519 AAAA... deploy@traffic-dashboard"
