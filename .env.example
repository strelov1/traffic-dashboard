# Copy to .env only if you want to override the defaults; docker compose up
# works without it.

# --- Published host ports ---
# Set these if 3000 or 8080 is already taken on your machine; Docker fails with
# "port is already allocated" when they are. Nothing else needs changing: the
# API's allowed origin and the origin baked into the frontend both follow.
API_PORT=3000
WEB_PORT=8080

# --- Postgres (read by the db service and composed into DATABASE_URL) ---
POSTGRES_USER=derq
POSTGRES_PASSWORD=derq
POSTGRES_DB=derq

# --- API ---
# Required. The API refuses to start without it, naming the variable.
DATABASE_URL=postgres://derq:derq@localhost:5432/derq
# Optional, defaults to 3000.
PORT=3000
# Optional, defaults to http://localhost:5173 (the Vite dev server).
# The single origin allowed to read API responses from a browser.
WEB_ORIGIN=http://localhost:5173

# --- Web ---
# Optional, defaults to http://localhost:3000. Inlined by Vite at build time,
# so it must be the origin the browser can reach.
VITE_API_ORIGIN=http://localhost:3000
